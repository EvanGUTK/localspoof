{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalSpoof",
  "version": "0.8.1",
  "identifier": "dev.localspoof.desktop",
  "build": {
    "beforeBuildCommand": "node ../tools/build-ui.mjs",
    "beforeDevCommand": "node ../tools/build-ui.mjs",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalSpoof",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "incognito": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local Android location simulator",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MkM5QzU4MTA1M0U4OEEKUldTSzZGTVFXSndzTkF4ZExKQzZRd0JWQ2Jvc3pLWDZNSjlwQkR3N0pmNE5wUVNRcit2RVhiNXEK",
      "endpoints": [
        "https://github.com/EvanGUTK/localspoof-releases/releases/latest/download/catalog.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
